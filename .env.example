# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.brilyx.com

# Contact form delivery (Resend, https://resend.com). Without RESEND_API_KEY and CONTACT_TO_EMAIL the form
# reports "not connected" and shows the email/WhatsApp fallback. It never pretends a message was sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend. The default (onboarding@resend.dev) can only deliver to
# the email address of your own Resend account, which is fine for a first test.
CONTACT_FROM_EMAIL=BRILYX Website <onboarding@resend.dev>
